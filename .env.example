# Supabase (required by all API routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Lemon Squeezy (required by /api/webhook)
LEMONSQUEEZY_SIGNING_SECRET=your-webhook-signing-secret

# Lemon Squeezy checkout URL (used in frontend)
# Format: https://your-store.lemonsqueezy.com/checkout/buy/<variant-id>
NEXT_PUBLIC_LS_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-variant-id
